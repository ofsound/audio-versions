// Copy this file to Secrets.xcconfig. The destination is gitignored.
// The publishable Supabase key is intended for client applications. Never put
// a service-role key or BLOB_READ_WRITE_TOKEN here.

AV_SUPABASE_URL = https:/$()/your-project.supabase.co
AV_SUPABASE_PUBLISHABLE_KEY = your-publishable-key
AV_API_BASE_URL = https:/$()/audio-versions.vercel.app
